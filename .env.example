# Base Sepolia deployment configuration.
# Copy to .env and fill in real values, or pass these inline on the command line.
# These are TESTNET-ONLY keys — never reuse an account that holds real funds, and never commit .env.

# JSON-RPC endpoint for Base Sepolia. Defaults to the public endpoint if unset.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Principal account private key (0x-prefixed). Sends the deploys, deposits, and most setup txs.
# Needs Base Sepolia ETH: https://portal.cdp.coinbase.com/products/faucet
PRIVATE_KEY=0x...

# Agent account private key (0x-prefixed). MUST be a different account from PRIVATE_KEY.
# Sends one tx (acceptMandate), so it only needs a small amount of gas.
# Generate one with: node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"
AGENT_PRIVATE_KEY=0x...
